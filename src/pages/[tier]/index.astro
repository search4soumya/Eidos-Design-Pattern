---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopicList from "../../components/TopicList.astro";
import { catalog, tierLabels, topicsByCategory, type Tier } from "../../lib/catalog";
import { baseUrl } from "../../lib/base";

export function getStaticPaths() {
  return (["basic", "intermediate", "advanced"] as Tier[]).map((tier) => ({ params: { tier } }));
}

const tier = Astro.params.tier as Tier;
if (!tierLabels[tier]) {
  return Astro.redirect(baseUrl);
}

const meta = tierLabels[tier];
const byCategory = topicsByCategory(tier);
const categories = [...byCategory.entries()];
const base = baseUrl;
---

<BaseLayout title={`${meta.label} (${meta.code})`} description={meta.blurb} activeTier={tier}>
  <div class="panel">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={base}>Home</a> / {meta.label}
    </nav>
    <header class="article-header">
      <p class="eyebrow">Skill Tier</p>
      <h1>{meta.label}</h1>
      <p class="lede">{meta.blurb}</p>
      <div class="article-meta">
        <span class="chip">{catalog.topics.filter((t) => t.tier === tier).length} topics</span>
        <span class="chip">{categories.length} categories</span>
      </div>
    </header>

    {
      categories.map(([category, topics]) => (
        <section class="category-block" id={category.toLowerCase().replace(/\s+/g, "-")}>
          <h2>{category}</h2>
          <TopicList topics={topics} />
        </section>
      ))
    }
  </div>
</BaseLayout>
