---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { catalog, tierLabels, seriesWithTopics, type Tier } from "../../lib/catalog";
import { baseUrl } from "../../lib/base";

export async function getStaticPaths() {
  const entries = await getCollection("topics");
  return entries.map((entry) => ({
    params: { tier: entry.data.tier, slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const meta = catalog.topics.find((t) => t.id === entry.data.id);
const base = baseUrl;
const tier = entry.data.tier as Tier;
const tierMeta = tierLabels[tier];

const prev = catalog.topics.find((t) => t.publishOrder === entry.data.publishOrder - 1);
const next = catalog.topics.find((t) => t.publishOrder === entry.data.publishOrder + 1);

const primarySeries = entry.data.series[0] ? seriesWithTopics(entry.data.series[0]) : null;
---

<BaseLayout
  title={entry.data.title}
  description={`${entry.data.id} · ${tierMeta.label} · ${entry.data.category}`}
  activeTier={tier}
  activeCategory={entry.data.category}
>
  <article class="panel essay">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={base}>Home</a> / <a href={`${base}${tier}/`}>{tierMeta.label}</a> / {entry.data.id}
    </nav>

    <header class="article-header">
      <div class="article-meta">
        <span class="chip">{entry.data.id}</span>
        <span class="chip">{tierMeta.label}</span>
        <span class="chip">{entry.data.category}</span>
      </div>
      <h1>{entry.data.title}</h1>
      {
        entry.data.series.length > 0 && (
          <div class="article-meta">
            {entry.data.series.map((s) => (
              <a class="chip" href={`${base}series/${s}/`}>
                Series: {s}
              </a>
            ))}
          </div>
        )
      }
    </header>

    {
      primarySeries && (
        <aside class="series-track" aria-label="Series position">
          <strong>Part of {primarySeries.title}</strong>
          <div class="series-track__list">
            {primarySeries.topics.map((t) =>
              t.id === entry.data.id ? (
                <span class="chip is-current">{t.id}</span>
              ) : (
                <a class="chip" href={`${base}${t.tier}/${t.slug}/`}>
                  {t.id}
                </a>
              ),
            )}
          </div>
        </aside>
      )
    }

    <TableOfContents headings={headings} />

    <div class="prose">
      <Content />
    </div>
    <script>
      import mermaid from "mermaid";

      const nodes = [...document.querySelectorAll<HTMLElement>(".mermaid")];
      for (const node of nodes) {
        if (!node.dataset.source) node.dataset.source = node.textContent ?? "";
      }

      async function renderDiagrams() {
        if (nodes.length === 0) return;
        const dark = document.documentElement.dataset.theme === "midnight" || document.documentElement.dataset.theme === "emerald";
        mermaid.initialize({
          startOnLoad: false,
          securityLevel: "strict",
          theme: dark ? "dark" : "neutral",
        });
        for (const node of nodes) {
          node.removeAttribute("data-processed");
          node.textContent = node.dataset.source ?? "";
        }
        await mermaid.run({ nodes });
      }

      await renderDiagrams();
      document.addEventListener("eidos-theme", () => {
        void renderDiagrams();
      });
    </script>

    <nav class="pager">
      {
        prev ? (
          <a href={`${base}${prev.tier}/${prev.slug}/`}>← {prev.id}</a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={`${base}${next.tier}/${next.slug}/`}>{next.id} →</a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</BaseLayout>
