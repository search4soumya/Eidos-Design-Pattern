---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Eidos" description="Eidos — essential forms of system design, from foundations to planet-scale patterns.">
  <section class="hero-stage" aria-label="Eidos">
    <div class="hero-stage__canvas" aria-hidden="true">
      <svg class="arch" viewBox="0 0 980 460">
        <defs>
          <linearGradient id="line" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#7aa2ff" />
            <stop offset="100%" stop-color="#6d4dff" />
          </linearGradient>
        </defs>
        <path class="arch__flow" d="M150 90 H300 V210 H460" />
        <path class="arch__flow arch__flow--slow" d="M150 210 H460" />
        <path class="arch__flow arch__flow--slow" d="M150 330 H300 V210" />
        <path class="arch__flow" d="M560 120 H700" />
        <path class="arch__flow arch__flow--slow" d="M560 250 H700" />
        <path class="arch__flow" d="M510 160 V360 H700" />
        <path class="arch__flow arch__flow--slow" d="M800 140 V230" />
        <g class="arch__node">
          <rect x="40" y="58" width="110" height="64" rx="14" />
          <text x="95" y="95">Client</text>
        </g>
        <g class="arch__node arch__node--delay">
          <rect x="40" y="178" width="110" height="64" rx="14" />
          <text x="95" y="215">Gateway</text>
        </g>
        <g class="arch__node">
          <rect x="40" y="298" width="110" height="64" rx="14" />
          <text x="95" y="335">Edge</text>
        </g>
        <g class="arch__node arch__node--delay">
          <rect x="460" y="168" width="120" height="84" rx="16" />
          <text x="520" y="206">Service</text>
          <text x="520" y="228" class="arch__sub">stateless</text>
        </g>
        <g class="arch__node">
          <rect x="700" y="78" width="120" height="64" rx="14" />
          <text x="760" y="115">Cache</text>
        </g>
        <g class="arch__node arch__node--delay">
          <rect x="700" y="218" width="120" height="64" rx="14" />
          <text x="760" y="255">Database</text>
        </g>
        <g class="arch__node">
          <rect x="700" y="338" width="120" height="64" rx="14" />
          <text x="760" y="375">Queue</text>
        </g>
      </svg>
      <div class="pattern-cycle">
        <span>Cache-aside</span>
        <span>Leader–follower</span>
        <span>Pub / sub</span>
        <span>Circuit breaker</span>
        <span>Shard key</span>
      </div>
    </div>
    <div class="hero-stage__copy">
      <p class="eyebrow">Architecture design patterns</p>
      <h1>Eidos</h1>
      <p class="lede">Essential forms of system design.</p>
    </div>
  </section>
</BaseLayout>
