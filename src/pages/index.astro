---
import BaseLayout from "../layouts/BaseLayout.astro";
import { catalog, tierLabels, type Tier } from "../lib/catalog";

const tiers: Tier[] = ["basic", "intermediate", "advanced"];
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Eidos" description="Three hundred system design patterns — basic, intermediate, and advanced — for architects and senior engineers.">
  <section class="hero container">
    <p class="hero__eyebrow">Lead software architect portfolio</p>
    <h1>Essential forms of system design</h1>
    <p class="hero__lead">
      <strong>Eidos</strong> (εἶδος — “essential form”) is a structured library of 300 essays. Read in tier order from newcomer to expert, or follow a cross-tier series on caching, data, resilience, messaging, or case studies.
    </p>
    <div class="hero__stats">
      <span class="stat-pill"><strong>300</strong> topics</span>
      <span class="stat-pill"><strong>3</strong> tiers · 100 each</span>
      <span class="stat-pill"><strong>5</strong> curated series</span>
      <span class="stat-pill">Target <strong>1,500–2,500</strong> words per post</span>
    </div>
  </section>

  <section class="section container" id="tiers">
    <div class="section__header">
      <h2>Choose your tier</h2>
      <p>Each tier builds on the previous one. Categories group related patterns inside each tier.</p>
    </div>
    <div class="tier-grid">
      {
        tiers.map((tier) => {
          const meta = tierLabels[tier];
          const count = catalog.topics.filter((t) => t.tier === tier).length;
          return (
            <a class="tier-card" href={`${base}${tier}/`}>
              <span class={`tier-card__badge tier-card__badge--${tier}`}>{meta.code} · {meta.label}</span>
              <h3>{meta.label} track</h3>
              <p>{meta.blurb}</p>
              <span class="tier-card__cta">{count} topics →</span>
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="section container" id="series">
    <div class="section__header">
      <h2>Cross-tier learning paths</h2>
      <p>Follow one theme from fundamentals through production-scale patterns.</p>
    </div>
    <div class="series-scroll">
      {
        catalog.series.map((s) => (
          <article class="series-card">
            <h3>{s.title}</h3>
            <p>{s.description}</p>
            <p class="series-card__meta">{s.topicIds.length} parts · spans B / I / A</p>
            <a href={`${base}series/${s.slug}/`}>View series →</a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section container">
    <div class="section__header">
      <h2>Start reading</h2>
      <p>Begin at B01 for the full journey, or jump to a series that matches your current project.</p>
    </div>
    <ul class="topic-list">
      {
        catalog.topics.slice(0, 8).map((t) => (
          <li>
            <span class="topic-list__id">{t.id}</span>
            <span class="topic-list__title">
              <a href={`${base}${t.tier}/${t.slug}/`}>{t.title}</a>
            </span>
            <span class="topic-list__status">{t.status}</span>
          </li>
        ))
      }
    </ul>
    <p style="margin-top: 1rem;">
      <a href={`${base}basic/`}>Browse all Basic topics →</a>
    </p>
  </section>
</BaseLayout>
