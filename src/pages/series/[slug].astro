---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopicList from "../../components/TopicList.astro";
import { catalog, seriesWithTopics } from "../../lib/catalog";
import { baseUrl } from "../../lib/base";

export function getStaticPaths() {
  return catalog.series.map((s) => ({ params: { slug: s.slug } }));
}

const slug = Astro.params.slug!;
const data = seriesWithTopics(slug);
if (!data) {
  return Astro.redirect(baseUrl);
}

const base = baseUrl;
---

<BaseLayout title={`Series: ${data.title}`} description={data.description}>
  <div class="container" style="padding: 2rem 0 3rem;">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={base}>Home</a> / Series / {data.title}
    </nav>
    <header class="article-header">
      <h1>{data.title}</h1>
      <p style="color: var(--text-muted); max-width: 52ch; margin: 0;">{data.description}</p>
      <div class="article-meta" style="margin-top: 1rem;">
        <span class="chip">{data.topics.length} articles</span>
        <span class="chip">Read in listed order</span>
      </div>
    </header>
    <TopicList topics={data.topics} />
  </div>
</BaseLayout>
