---
import type { TopicMeta } from "../lib/catalog";

interface Props {
  topics: TopicMeta[];
}

const { topics } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<ul class="topic-list">
  {
    topics.map((t) => (
      <li>
        <span class="topic-list__id">{t.id}</span>
        <span class="topic-list__title">
          <a href={`${base}${t.tier}/${t.slug}/`}>{t.title}</a>
        </span>
        <span class="topic-list__status">{t.status}</span>
      </li>
    ))
  }
</ul>
