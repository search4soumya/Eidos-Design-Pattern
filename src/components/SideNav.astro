---
import { categoriesInOrder, tierLabels, type Tier } from "../lib/catalog";
import { baseUrl } from "../lib/base";

interface Props {
  activeTier?: Tier;
  activeCategory?: string;
}

const { activeTier, activeCategory } = Astro.props;
const base = baseUrl;
const tiers: Tier[] = ["basic", "intermediate", "advanced"];
const categories = categoriesInOrder();

function tierHref(tier: Tier) {
  return `${base}${tier}/`;
}

function isTierActive(tier: Tier) {
  if (activeTier === tier) return true;
  return Astro.url.pathname.includes(`/${tier}/`) || Astro.url.pathname.endsWith(`/${tier}`);
}
---

<aside class="sidenav" aria-label="Library">
  <div class="sidenav__group">
    <button type="button" class="sidenav__label" aria-expanded="false" aria-controls="sidenav-tiers">
      Skill Tier
      <span class="sidenav__chevron" aria-hidden="true"></span>
    </button>
    <nav id="sidenav-tiers" hidden>
      {
        tiers.map((tier) => {
          const meta = tierLabels[tier];
          const active = isTierActive(tier);
          return (
            <a class:list={["sidenav__link", { "is-active": active }]} href={tierHref(tier)} aria-current={active ? "page" : undefined}>
              <span class={`sidenav__mark sidenav__mark--${tier}`}>{meta.code}</span>
              {meta.label}
            </a>
          );
        })
      }
    </nav>
  </div>

  <div class="sidenav__group">
    <button type="button" class="sidenav__label" aria-expanded="false" aria-controls="sidenav-categories">
      Category
      <span class="sidenav__chevron" aria-hidden="true"></span>
    </button>
    <nav id="sidenav-categories" hidden>
      {
        categories.map((category) => {
          const active = activeCategory === category.name;
          return (
            <a
              class:list={["sidenav__link", { "is-active": active }]}
              href={`${base}category/${category.slug}/`}
              aria-current={active ? "page" : undefined}
            >
              <span class="sidenav__count">{category.topics.length}</span>
              {category.name}
            </a>
          );
        })
      }
    </nav>
  </div>
</aside>

<script>
  const groups = document.querySelectorAll<HTMLElement>(".sidenav__group");

  function setOpen(group: Element, open: boolean) {
    const button = group.querySelector<HTMLButtonElement>(".sidenav__label");
    const panel = group.querySelector("nav");
    button?.setAttribute("aria-expanded", open ? "true" : "false");
    if (panel) panel.hidden = !open;
  }

  for (const group of groups) {
    const button = group.querySelector(".sidenav__label");
    button?.addEventListener("click", () => {
      const willOpen = button.getAttribute("aria-expanded") !== "true";
      for (const other of groups) setOpen(other, other === group && willOpen);
    });
  }
</script>
