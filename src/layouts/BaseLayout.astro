---
import "../styles/global.css";
import SideNav from "../components/SideNav.astro";
import { catalog, type Tier } from "../lib/catalog";
import { baseUrl } from "../lib/base";

interface Props {
  title: string;
  description?: string;
  activeTier?: Tier;
  activeCategory?: string;
}

const {
  title,
  description = "Eidos — 300 system design essays from basic to advanced.",
  activeTier,
  activeCategory,
} = Astro.props;
const fullTitle = title === "Eidos" ? "Eidos" : `${title} · Eidos`;
const base = baseUrl;
const path = Astro.url.pathname;

const pills = [
  { label: "Home", href: base, current: path === base || path === `${base}index.html` },
  { label: "Basic", href: `${base}basic/`, current: path.includes("/basic") },
  { label: "Intermediate", href: `${base}intermediate/`, current: path.includes("/intermediate") },
  { label: "Advanced", href: `${base}advanced/`, current: path.includes("/advanced") },
  ...catalog.series.map((series) => ({
    label: series.title,
    href: `${base}series/${series.slug}/`,
    current: path.includes(`/series/${series.slug}`),
  })),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        var allowed = ["blueprint", "midnight", "paper", "forest"];
        var saved = localStorage.getItem("eidos-theme");
        var theme = allowed.indexOf(saved) >= 0 ? saved : "blueprint";
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="topbar">
        <div class="topbar__inner">
          <a class="brand" href={base}>
            <span class="brand__mark" aria-hidden="true">E</span>
            <span class="brand__title">Eidos</span>
          </a>
          <nav class="topnav" aria-label="Primary">
            <a href={`${base}about/`} aria-current={path.includes("/about") ? "page" : undefined}>About me</a>
            <a href={`${base}#contact`}>Contact</a>
          </nav>
          <label class="theme-picker">
            Theme
            <select id="theme-select" aria-label="Theme">
              <option value="blueprint">Blueprint</option>
              <option value="midnight">Midnight</option>
              <option value="paper">Paper</option>
              <option value="forest">Forest</option>
            </select>
          </label>
        </div>
      </header>

      <div class="subbar">
        <div class="subbar__identity">
          <p class="subbar__kicker">Eidos · Design patterns</p>
          <p class="subbar__sub">System design library</p>
        </div>
        <nav class="pills" aria-label="Sections">
          {
            pills.map((pill) => (
              <a class:list={["pill", { "is-active": pill.current }]} href={pill.href} aria-current={pill.current ? "page" : undefined}>
                {pill.label}
              </a>
            ))
          }
        </nav>
      </div>

      <div class="workspace">
        <SideNav activeTier={activeTier} activeCategory={activeCategory} />
        <main class="workspace__main">
          <slot />
        </main>
      </div>

      <footer class="site-footer" id="contact">
        <div class="footer-card">
          <p class="eyebrow">Let's Connect</p>
          <p class="footer-line">
            Whether you're interested in collaboration, consulting, or just want to discuss architecture and technology, I'd love to hear from you.
          </p>
          <div class="socials">
            <a href="https://github.com/search4soumya" aria-label="GitHub" target="_blank" rel="noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2C6.48 2 2 6.58 2 12.26c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.49 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.55-1.14-4.55-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05a9.3 9.3 0 0 1 2.5-.34c.85 0 1.7.11 2.5.34 1.9-1.32 2.74-1.05 2.74-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.81 0 .27.18.6.69.49A10.04 10.04 0 0 0 22 12.26C22 6.58 17.52 2 12 2Z"/></svg>
              <span>GitHub</span>
            </a>
            <a href="https://www.linkedin.com/in/search4soumya" aria-label="LinkedIn" target="_blank" rel="noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4.98 3.5C4.98 4.88 3.88 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.5 8.5h4V24h-4V8.5zM8.5 8.5h3.8v2.1h.05c.53-1 1.84-2.1 3.79-2.1 4.05 0 4.8 2.67 4.8 6.14V24h-4v-7.7c0-1.84-.03-4.2-2.56-4.2-2.56 0-2.95 2-2.95 4.06V24h-4V8.5z"/></svg>
              <span>LinkedIn</span>
            </a>
            <a href="https://x.com/search4soumya" aria-label="Twitter" target="_blank" rel="noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M22 5.8c-.7.3-1.4.5-2.2.6a3.7 3.7 0 0 0 1.6-2c-.7.4-1.5.8-2.4.9A3.64 3.64 0 0 0 12 8.6a10.3 10.3 0 0 1-7.5-3.8 3.63 3.63 0 0 0 1.1 4.85 3.6 3.6 0 0 1-1.65-.46v.05a3.65 3.65 0 0 0 2.92 3.57 3.7 3.7 0 0 1-1.64.06 3.66 3.66 0 0 0 3.41 2.54A7.3 7.3 0 0 1 2 17.54 10.3 10.3 0 0 0 7.58 19c6.68 0 10.34-5.54 10.34-10.34v-.47A7.4 7.4 0 0 0 22 5.8Z"/></svg>
              <span>Twitter</span>
            </a>
            <a href="mailto:search4soumya@gmail.com" aria-label="Email">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M2 6.5A2.5 2.5 0 0 1 4.5 4h15A2.5 2.5 0 0 1 22 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 2 17.5v-11Zm2.2-.3 7.1 5.1a1.2 1.2 0 0 0 1.4 0l7.1-5.1H4.2Zm15.3 1.7-6.3 4.5a2.7 2.7 0 0 1-3.2 0L3.7 7.9V17.5c0 .3.2.5.5.5h15.6c.3 0 .5-.2.5-.5V7.9Z"/></svg>
              <span>Email</span>
            </a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>

<script>
  const themeSelect = document.querySelector<HTMLSelectElement>("#theme-select");
  const allowed = ["blueprint", "midnight", "paper", "forest"];
  if (themeSelect) {
    const current = document.documentElement.dataset.theme;
    themeSelect.value = current && allowed.includes(current) ? current : "blueprint";
    themeSelect.addEventListener("change", () => {
      document.documentElement.dataset.theme = themeSelect.value;
      localStorage.setItem("eidos-theme", themeSelect.value);
      document.dispatchEvent(new CustomEvent("eidos-theme"));
    });
  }
</script>
